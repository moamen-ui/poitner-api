# Caddy auto-provisions Let's Encrypt certs for each site (HTTP-01).
# api.pointer  → reverse-proxy to the API.
# app.pointer / demo.pointer → the React dashboard build (SPA fallback).
# Since 2026-09-15 only the React dashboard exists (`pointer-dashboard/react`); Angular and Vue
#   were retired at tag `last-three-apps` / branch `legacy/angular-vue`, and the per-framework
#   app-<fw>.pointer hosts were removed from DNS the same day (no site blocks for them here —
#   Caddy would otherwise keep failing to issue certs for names that no longer resolve).

# Shared static-SPA config. index.html and the runtime-fetched i18n JSON carry fixed
# (non-fingerprinted) names, so force revalidation on them (etag → 304 when unchanged)
# to avoid serving a stale bundle/translations after a deploy. Hashed JS/CSS keep the
# browser default and stay cached.
(dashboard) {
    encode gzip
    try_files {path} {path}/index.html /index.html
    # Revalidate everything EXCEPT fingerprinted static assets — i.e. index.html (every SPA
    # route) and the runtime-fetched i18n JSON, which have fixed names. Matched on the original
    # request path (header runs before try_files), so this covers all SPA navigations. Hashed
    # JS/CSS/fonts/images keep the browser default and stay cached.
    @nocache not path *.js *.mjs *.css *.map *.woff *.woff2 *.ttf *.eot *.otf *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp *.avif
    header @nocache Cache-Control "no-cache"
    file_server
}

# R5-59: baseline security headers, shared by every site block below. CSP is intentionally NOT
# included here — it differs per host (dashboard vs API vs landing), so each site block sets its
# own Content-Security-Policy-Report-Only. X-Frame-Options defaults to DENY here; the API host
# overrides it to SAMEORIGIN (it serves the widget check/swagger pages, framed by themselves).
(security-headers) {
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "{args[0]}"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        -Server
    }
}

# R5-59: RFC 9116 security.txt, identical on every host. `handle` is evaluated ahead of
# try_files/file_server/reverse_proxy in Caddy's default directive order and `respond` is
# terminal, so this always wins over the dashboard SPA fallback and the API reverse proxy.
(security-txt) {
    handle /.well-known/security.txt {
        header Content-Type "text/plain; charset=utf-8"
        respond <<TXT
Contact: mailto:moamen.ui@gmail.com
Preferred-Languages: en, ar
Expires: 2027-09-22T00:00:00.000Z
TXT 200
    }
}

api.pointer.moamen.work {
    # The widget loader/styles/skill are UNHASHED and updated in place on every deploy. Without this,
    # browsers (and the extension's injected <script src=".../widget.js">) heuristically cache the old
    # copy — stale widget, and the "widget auto-updates from the server" premise silently breaks.
    # /api/branding is the live branding config (name/urls) consumed by landing+dashboards+widget;
    # keep it revalidated so rebrands propagate. (Its /asset/* subpath is versioned by ?v and keeps
    # its own long cache — the exact-path matcher below does not include the asset subpath.)
    #
    # `not query v=*` is load-bearing. The matcher is otherwise query-blind, so it also matched
    # /widget.js?v=<hash> — a PINNED, content-addressed build the API serves as
    # `public, max-age=31536000, immutable` — and overwrote that with no-cache. The pin still got
    # the right bytes, but the year of caching it exists to buy was destroyed at the proxy, and
    # nothing about the response looked wrong. Excluding any request that carries `v` lets both
    # `?v=<hash>` (immutable) and `?v=stable` (one hour) keep the headers the API chose.
    #
    # An EMPTY `?v=` matches `query v=*` too, so it is excluded here and falls through to the API,
    # which treats it as an unknown hash and returns 404 with the version-mismatch header. That is
    # the intended answer: an empty pin is a broken pin, not "no pin".
    @widget {
        path /widget.js /widget.css /embed.js /skill.md /api/branding
        not query v=*
    }
    # `>` replaces rather than appends. Without it Caddy adds its value alongside the API's own
    # no-cache, and the response carries "no-cache, must-revalidate, no-cache" — harmless to a
    # browser, but it means the header a client sees is not the one this file specifies.
    header @widget >Cache-Control "no-cache, must-revalidate"

    import security-headers SAMEORIGIN
    import security-txt
    # The widget is embedded via <script>/<iframe> on arbitrary customer sites, and Swagger/the
    # /check page are framed by themselves — DENY (the shared default) would break both.
    # Report-only for one deploy cycle (§9 release steps) before switching to enforced CSP.
    # frame-ancestors * mirrors the SAMEORIGIN override above: the widget must be embeddable by
    # any customer origin.
    header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors *; base-uri 'self'"

    reverse_proxy api:8080
}

# Default dashboard host → the React dashboard (the only dashboard since 2026-09-15).
app.pointer.moamen.work {
    root * /srv/dashboard/react
    import dashboard
    import security-headers DENY
    import security-txt
    # Report-only for one deploy cycle (§9 release steps) before switching to enforced CSP. The
    # dashboard loads the Pointer widget (script + styles) from the API origin and calls the API
    # for data; style-src needs 'unsafe-inline' because the widget injects inline styles.
    header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://api.pointer.moamen.work; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.pointer.moamen.work; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
}

# Demo host → the dashboard with the "Try the demo" entry (guests provision an
# ephemeral, self-expiring tenant). Same React build as app.pointer.
demo.pointer.moamen.work {
    root * /srv/dashboard/react
    import dashboard
    import security-headers DENY
    import security-txt
    header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://api.pointer.moamen.work; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.pointer.moamen.work; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
}

# Bare domain → the marketing landing page (served from the bind-mounted landing/ dir).
pointer.moamen.work {
    root * /srv/landing
    import dashboard
    import security-headers DENY
    import security-txt
    # landing/index.html fetches the API (plans/stacks-summary/stats/branding) and loads the
    # widget loader script + the <pointer-feedback> element from the API origin
    # (landing/index.html:942,1010,1046,1105,1166,1265,1268) — so, unlike the doc's original
    # "self-only connect-src" draft, script-src/connect-src must allow the API origin too, same
    # as the dashboard hosts. style-src needs 'unsafe-inline' for the same widget reason.
    header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://api.pointer.moamen.work; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.pointer.moamen.work; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
}
