{
  "manifest_version": 3,
  "name": "Pointer Feedback",
  "version": "0.2.0",
  "description": "Leave element-level feedback on any page and turn it into code with AI — powered by your Pointer server.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pointer Feedback",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["https://api.pointer.moamen.work/*"],
  "optional_host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["vendor/snapdom.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
