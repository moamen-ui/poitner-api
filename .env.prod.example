# Copy to .env.prod (gitignored) and fill in real values, then:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# Generate secrets with e.g. `openssl rand -hex 32`.

# Postgres password (used by both db and api).
DB_PASSWORD=change-me

# JWT HS256 signing key — must be >= 32 chars.
# IMPORTANT: this is also the root secret for API-key encryption (ApiKeyProtector), password-reset
# tokens (ResetTokenService), signed upload URLs (UploadSigner) and audit IP hashing (AuditWriter) —
# they all read JWT_SIGNING_KEY directly. NEVER change this value to rotate the JWT signing key;
# rotate through the JWT_KEY_0_*/JWT_KEY_1_* slots below instead. See DEPLOY.md § "JWT key rotation
# (R5-62)".
JWT_SIGNING_KEY=change-me-to-a-long-random-string

# R5-62: JWT key rotation (kid header, two-key window). Leave the vars below empty/unset for an
# ordinary deployment — the API boots with a single key ("k0" = JWT_SIGNING_KEY above) and needs no
# changes.
#   JWT_ACTIVE_KEY_ID — which key id new tokens are signed with; defaults to k0
#   JWT_KEY_0_ID      — slot 0's id; defaults to k0
#   JWT_KEY_0_SECRET  — slot 0's secret; defaults to JWT_SIGNING_KEY above. Set this (not
#                       JWT_SIGNING_KEY) to rotate k0's own secret without touching the shared root
#                       secret used by the subsystems above.
#   JWT_KEY_1_ID      — the new key's id, e.g. k1
#   JWT_KEY_1_SECRET  — the new key's secret (>= 32 chars); generate with `openssl rand -hex 32`
JWT_ACTIVE_KEY_ID=
JWT_KEY_0_ID=
JWT_KEY_0_SECRET=
JWT_KEY_1_ID=
JWT_KEY_1_SECRET=

# Seeded admin account (created on first boot). Change the password!
ADMIN_EMAIL=admin@pointer.local
ADMIN_PASSWORD=change-me

# Public API origin — used to build embed.js / served-skill URLs (no trailing slash).
POINTER_SERVER=https://api.pointer.moamen.work

# Transactional email (Brevo). Leave EMAIL_ENABLED=false until the domain/sender is
# verified in Brevo and DNS (SPF/DKIM) is set — otherwise sends are skipped (no-op).
#   EMAIL_FROM_EMAIL must be a Brevo-verified sender/domain.
#   Per-day send cap is the AppSetting "email_daily_cap" (default 250, < Brevo's 300/day).
EMAIL_ENABLED=false
EMAIL_API_KEY=
EMAIL_FROM_EMAIL=no-reply@pointer.moamen.work
EMAIL_FROM_NAME=Pointer

# DB_APPLY_CONTRACT is deliberately absent: scripts/deploy-api.sh exports it per run (DB-09). Do not add it here.

# DB-08 row retention (days). Job is ON by default; RETENTION_ENABLED=false pauses it. 0 disables one table.
RETENTION_ENABLED=true
RETENTION_USAGE_EVENTS_DAYS=180
RETENTION_NOTIFICATIONS_READ_DAYS=90
RETENTION_SNAPSHOT_DAYS=30
RETENTION_INVITES_DAYS=90

# Optional: rclone remote:bucket for nightly off-box copies (scripts/offsite-backup.sh). Empty = disabled.
# Not a secret — the rclone credentials themselves live only in ~/.config/rclone/rclone.conf on the VM
# (mode 600), never in this repo.
OFFSITE_REMOTE=
# Optional: heartbeat URL pinged after each successful off-box copy (healthchecks.io / UptimeRobot / Cronitor). Empty = no ping.
OFFSITE_HEALTHCHECK_URL=

# Error tracking (Sentry). Leave empty to disable.
SENTRY_DSN=
# Dead-man's-switch uptime ping URL (healthchecks.io). Pinged every 60s when /health is healthy.
UPTIME_PING_URL=
